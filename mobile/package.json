{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "^58.0.22",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "query-string": {
      "decode-uri-component": "0.5.0"
    }
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "test:returning-user": "playwright test",
    "test:ai-validation": "node --test tests/ai-activity.test.cjs tests/ai-activity-practice.test.cjs tests/ai-activity-recovery.test.cjs tests/gap-reflection.test.cjs tests/sensation-lexicon.test.cjs tests/week-one.test.cjs tests/week-two.test.cjs && npm run check:client-security && node --test tests/integration/endpoint/guided-reflection-fixtures.test.cjs && node --test tests/integration/endpoint/ai-activity-http.test.cjs",
    "test:endpoint-integration": "node --test tests/integration/endpoint/endpoint-http.test.cjs && node --test tests/integration/endpoint/guided-reflection-fixtures.test.cjs && node --test tests/integration/endpoint/ai-activity-http.test.cjs",
    "check:client-security": "node scripts/check-client-security.cjs",
    "prestart": "npm run check:client-security",
    "preandroid": "npm run check:client-security",
    "preios": "npm run check:client-security",
    "preweb": "npm run check:client-security",
    "preexport": "npm run check:client-security",
    "export": "expo export",
    "postexport": "node scripts/check-client-security.cjs --bundle dist",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "private": true
}
